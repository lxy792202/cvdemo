              "产品名称",
              "产品优势",
              "联系电话"
            ]
          },
          {
            "index": 2,
            "theme": "多产品组合",
            "items": [
              "多种产品组合展示",
              "主营产品介绍",
              "企业优势",
              "联系电话"
            ]
          },
          {
            "index": 3,
            "theme": "企业实力",
            "items": [
              "企业实力展示",
              "厂房或生产场景",
              "企业真实经营数据",
              "联系电话"
            ],
            "examples": [
              "5000㎡厂房",
              "10余年行业经验"
            ],
            "data_rule": "示例数据仅在企业资料真实提供时使用"
          }
        ]
      },
      {
        "id": "product_main",
        "name": "产品主图",
        "required": true,
        "count": "按产品分类及产品数量生成",
        "size": {
          "width": 800,
          "height": 600,
          "unit": "px"
        },
        "aspect_ratio": "4:3",
        "filename": "{company_name}_主图{index}.png",
        "content": {
          "items": [
            "产品名称",
            "产品图片",
            "产品优势",
            "厂家优势"
          ],
          "product_advantages": {
            "count": "2-4",
            "examples": [
              "坚固耐用",
              "雕刻精细"
            ]
          },
          "factory_advantages": [
            "源头厂家",
            "批量供应",
            "按需定制"
          ],
          "visual_style": [
            "与品牌主色调一致",
            "产品单体抠图",
            "场景化展示",
            "图文结合排版",
            "突出产品主体"
          ]
