        "required": true,
        "count": 1,
        "size": {
          "width": 1420,
          "height": "1000-1400",
          "unit": "px"
        },
        "text_safe_width": 1200,
        "filename": "{company_name}_优势.png",
        "content": {
          "sections": [
            {
              "id": "core_advantages",
              "title": "企业核心优势",
              "item_count": "3-4",
              "description_max_chars": 30
            },
            {
              "id": "service_process",
              "title": "服务流程",
              "item_count": "4-6",
              "each_item": {
                "name": "服务步骤名称",
                "description_max_chars": 15
              }
            }
          ],
          "requirements": [
            "上下分区设计",
            "优势内容突出",
            "流程清晰易懂",
            "文字位于中间1200px有效区域"
          ]
        }
      },
      {
        "id": "contact",
        "name": "联系我们",
        "required": true,
        "count": 1,
        "size": {
          "width": 1420,
          "height": 444,
          "unit": "px"
        },
        "aspect_ratio": "710:222",
        "filename": "{company_name}_联系我们.png",
        "content": {
          "background_options": [
            "团队协作场景",
            "厂区场景",
            "扁平化商务设计"
          ],
          "layout": {
            "left_blank_width": 500,
            "unit": "px",
            "purpose": "预留文字和联系信息区域"
          },
          "requirements": [
            "与品牌主色调一致",
            "背景适当降低亮度",
            "可以增加半透明遮罩",
            "确保文字清晰",
            "突出联系电话和咨询信息"
          ]
        }
      }
      
    ]
