
{
  "global_rules": {
    "language": "zh-CN",
    "output_format": "image",
    "design_principles": [
      "根据企业所属行业选择统一的视觉风格",
      "所有图片保持统一的主色调、字体风格和视觉元素",
      "文案通俗易懂，突出实际产品和企业优势",
      "不得虚构企业资质、厂房面积、设备数量、产能、案例和服务承诺",
      "企业信息优先使用提供的真实资料",
      "缺少的数据不自行编造，可以省略或使用概括性表达",
      "图片中的文字必须清晰、准确，不得出现乱码",
      "根据投放场景选择合适的图片比例和排版方式"
    ],
    "image_quality": {
      "resolution": "高清",
      "text_readability": "文字清晰可读",
      "composition": "布局合理，重点突出",
      "visual_consistency": "统一品牌视觉风格"
    }
  },
  "pc_design": {
    "description": "PC端企业店铺设计素材",
    "materials": [
      {
        "id": "logo",
        "name": "公司Logo",
        "required": true,
        "count": 1,
        "size": {
          "width": 1120,
          "height": 217,
          "unit": "px"
        },
        "aspect_ratio": "1120:217",
        "filename": "{company_name}_logo.png",
        "content": {
          "layout": "上下两排排版",
          "background": "纯白色背景",
          "options": [
            {
              "type": "short_name",
              "items": [
                "公司简称",
                "公司Logo",
                "厂家优势",
                "联系电话"
              ]
            },
            {
              "type": "full_name",
              "items": [
                "公司全称",
                "主营业务",
                "联系电话"
              ]
            }
          ],
          "requirements": [
            "品牌名称突出",
            "信息排版整齐",
            "整体简洁商务"
          ]
        }
      },
      {
        "id": "company_intro",
        "name": "公司介绍图",
        "required": true,
        "count": 1,
        "size": {
          "width": 790,
          "height": 444,
          "unit": "px"
        },
        "aspect_ratio": "16:9",
        "filename": "{company_name}_公司简介.png",
        "content": {
          "image_subjects": [
            "厂区",
            "生产车间",
            "生产线",
            "产品组合",
            "仓储",
            "发货"
          ],
          "copywriting": {
            "main_title": {
              "min_chars": 6,
              "max_chars": 15
            },
            "description": {
              "target_chars": 30
            },
            "advantages": {
              "count": "2-3",
              "min_chars_per_item": 4,
              "max_chars_per_item": 8
            }
          },
          "requirements": [
            "突出企业形象",
            "图片与企业实际业务相关",
            "文案简洁",
            "图文排版协调"
          ]
        }
      },
      {
        "id": "banner",
        "name": "首页轮播图",
        "required": true,
        "count": 2,
        "size": {
          "width": 1420,
          "height": 532,
          "unit": "px"
        },
        "aspect_ratio": "710:266",
        "filename": "{company_name}_banner{index}.png",
        "content": [
          {
            "index": 1,
            "theme": "主推产品",
